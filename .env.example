# Application
APP_NAME=hidden-cycle-discovery
APP_ENV=production
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql+asyncpg://hcd_user:hcd_password@postgres:5432/hcd_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=hidden-cycle-discovery

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Data Sources
ALPHA_VANTAGE_API_KEY=your-key
TWELVE_DATA_API_KEY=your-key
NSE_DATA_ENABLED=true

# ML / GPU
DEVICE=cuda  # or cpu
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
NUM_WORKERS=4

# Ephem (planetary)
EPHEM_ENABLED=true

# Stripe (monetization)
STRIPE_SECRET_KEY=your-stripe-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# Celery
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4
FLOWER_BASIC_AUTH=admin:password

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn

# ─── Indian Broker APIs (optional — users connect their own) ───
# Zerodha Kite Connect (₹500/mo plan for data)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/providers/upstox/callback
# Angel One SmartAPI
ANGELONE_API_KEY=
# Dhan (long-lived token)
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
# Fyers
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/providers/fyers/callback
